{
  "schema": "hung-proxy-calibration-v1",
  "scope": "development_only",
  "seeds": [7, 11, 19],
  "history_days": [7, 14, 28],
  "methods": ["source_error", "uncertainty", "drift"],
  "recipes_per_method": 4,
  "thresholds": {
    "source_error": [[0.1, 0.5], [0.05, 0.25]],
    "uncertainty": [[0.01, 0.05], [0.005, 0.025]],
    "drift": [[0.5, 1.5], [1.0, 3.0]]
  },
  "mapping_orders": ["ascending", "descending"],
  "drift_scale_floor": 0.1,
  "selection_rule": "equal_budget_station_seed_mae_kwh_then_recipe_index",
  "max_origins": 90,
  "device": "cpu",
  "controller": {
    "level_one": 0.1,
    "level_two": 0.2,
    "initial_level": 0.0,
    "block_days": 14,
    "min_complete_days": 5,
    "delta": 0.0,
    "alpha": 0.05,
    "bootstrap_segment_days": 2,
    "bootstrap_resamples": 100,
    "challenger_rule": "bonferroni_two",
    "epsilon": 0.000001
  }
}
